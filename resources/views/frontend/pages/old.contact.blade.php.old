        padding: 10px 20px;
    }
    .modal-dialog .modal-content {
        width: 50%;
        border-radius: 0;
        margin: auto;
    }
    @media (max-width: 768px) {
        .modal-dialog .modal-content {
            width: 90%;
        }
    }
    .close {
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        opacity: 0.7;
        transition: opacity 0.2s;
    }
    .close:hover {
        opacity: 1;
    }
    .text-success {
        color: #28a745 !important;
    }
    .text-warning {
        color: #ffc107 !important;
    }
</style>
